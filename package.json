{
  "name": "dwc-call-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "German call-reason classification prototype and portable synthetic demo",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "dev:api": "tsx src/server/start.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-demo.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "start": "tsx src/server/start.ts",
    "test": "tsx --test tests/engine/*.test.ts",
    "test:ui": "playwright test",
    "backup:local": "tsx src/server/backup.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests scripts vite.config.ts playwright.config.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.12",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
