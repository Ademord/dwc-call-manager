    "/api/reports/export": {
      "post": {
        "operationId": "exportReport",
        "description": "Manager only. Download the exact row set of the displayed summary. Reject expired/evicted tokens with 410; unauthorized tokens use 404. CSV cells neutralize formula prefixes.",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "UTF-8 BOM, semicolon-separated CSV, same snapshot as dashboard.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Report-Timezone": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Report-From": {
                "schema": {
                  "type": "string",
                  "format": "date"
                }
              },
              "X-Report-Until": {
                "schema": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
